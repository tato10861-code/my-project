# PropAuto AI — environment template (safe to commit; copy to .env and fill in)
# ⛔ Never put real values in this file. Real secrets live in .env (gitignored)
#    or in the Vercel project settings.

# ── Neon Postgres (production database) ────────────────────────────────
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST-POOLER/neondb?channel_binding=require&connect_timeout=15&sslmode=require
POSTGRES_URL=postgresql://USER:PASSWORD@HOST-POOLER/neondb?channel_binding=require&sslmode=require
POSTGRES_URL_NO_SSL=postgresql://USER:PASSWORD@HOST-POOLER/neondb
POSTGRES_DATABASE=neondb
POSTGRES_HOST=HOST-POOLER

# ── Vercel Blob (webhook signature verification) ───────────────────────
BLOB_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
REPLACE_WITH_YOUR_KEY
-----END PUBLIC KEY-----

# ── Optional integrations ──────────────────────────────────────────────
# NHOST_GRAPHQL_URL=
# NHOST_ADMIN_SECRET=
# STRIPE_SECRET_KEY=
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# CRM_WEBHOOK_URL=

# ── Server ─────────────────────────────────────────────────────────────
# PORT=5173
# DATA_DIR=data
CI=1

# ── Vercel API (for recovery probes; create your own token at vercel.com/account/tokens) ──
# VERCEL_TOKEN=