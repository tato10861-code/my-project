# PropAuto AI — environment template. Safe to commit: names only, no values.
# Real values live in .env.local (gitignored) or in the Vercel project settings.

NEXT_PUBLIC_ENV=development
# Public https origin used for payment return URLs (http allowed only in development).
NEXT_PUBLIC_SITE_URL=

# ── Database (Neon Postgres) ─────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (better-auth) ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Sarah's model ───────────────────────────────────────────────────────
# Optional. A free Gemini key from https://aistudio.google.com/apikey makes Sarah
# call Google directly, with no card on file. When unset, Sarah uses Vercel AI
# Gateway, which needs a card on the Vercel account.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Gemini model Sarah uses (default gemini-3.8-flash). Change it here
# if Google retires a version, with no code change.
SARAH_MODEL=

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Payments (Stripe) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/webhooks/stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=
# "true" turns on Stripe Tax for subscriptions; set the head office address in
# Stripe's tax settings first, or Stripe rejects the checkout.
STRIPE_AUTOMATIC_TAX=
# Customer-portal login link (Stripe Billing > Customer portal) shown under the plans.
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# ── Voice concierge (Vapi) ──────────────────────────────────────────────
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# ── Market data provider ────────────────────────────────────────────────
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

NEXT_PUBLIC_API_URL=

# Booking requests from Sarah (viewings and test drives). Booking stays off until all are set.
# BOOKING_SECRET signs the confirmation link in the team's email. Use 32+ random characters.
BOOKING_SECRET=
# Public base URL of this deployment, used to build the confirmation link.
PUBLIC_APP_URL=
# Mailbox that receives booking requests to confirm.
BOOKING_NOTIFY_EMAIL=
# Sender for booking emails. Use one of:
#  - RESEND_FROM_EMAIL with RESEND_API_KEY (a verified domain sender), or
#  - GMAIL_APP_PASSWORD for BOOKING_NOTIFY_EMAIL (a Google app password, no domain needed).
GMAIL_APP_PASSWORD=
