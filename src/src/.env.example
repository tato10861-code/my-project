# PropAuto AI — environment template. Safe to commit: names only, no values.
# Real values live in .env.local (gitignored) or in the Vercel project settings.

NEXT_PUBLIC_ENV=development
# Public https origin used for payment return URLs (http allowed only in development).
NEXT_PUBLIC_SITE_URL=

# ── Database (Neon Postgres) ─────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (better-auth) ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Payments (Stripe) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/webhooks/stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=

# ── Voice concierge (Vapi) ──────────────────────────────────────────────
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# ── Market data provider ────────────────────────────────────────────────
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

NEXT_PUBLIC_API_URL=
