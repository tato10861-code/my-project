{
  "name": "propauto-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir src/src dev",
    "build": "pnpm --dir src/src install --frozen-lockfile && pnpm --dir src/src build && rm -rf .next && cp -R src/src/.next .next",
    "start": "pnpm --dir src/src start",
    "lint": "pnpm --dir src/src lint"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "next": "16.3.8",
    "react": "^19",
    "react-dom": "^19"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "source-map-js": "1.2.2"
    }
  }
}
