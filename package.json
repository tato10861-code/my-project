{
  "name": "propauto-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8",
  "workspaces": [
    "src/src"
  ],
  "scripts": {
    "dev": "pnpm --filter my-project dev",
    "build": "pnpm --filter my-project build && rm -rf .next && cp -R src/src/.next .next",
    "start": "pnpm --filter my-project start",
    "lint": "pnpm --filter my-project lint"
  },
  "engines": {
    "node": "24.x"
  }
}
