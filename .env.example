.env.example

# Example environment variables for PropAuto AI
# Do NOT commit secrets. Copy this file to .env.local and fill values.

# Resend email service
RESEND_API_KEY=
RESEND_API_KEY_2=
RESEND_FROM_EMAIL=PropAuto Sales <onboarding@example.com>

# Database (Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/propauto

# Analytics / public keys
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
NEXT_PUBLIC_APP_URL=https://your-deployment-url.example

# Node environment
NODE_ENV=development
